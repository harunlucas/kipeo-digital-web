# Copy to .env.local for development, and set the same names in your
# Vercel project settings for production. See docs/contact-form-setup.md.

# Required for the /contact form to send email (Brevo transactional API).
# Never expose these to the client — they're read only in src/app/api/contact/route.ts
# and src/lib/email/*, which run server-side.
BREVO_API_KEY=
CONTACT_FROM_EMAIL=
# Optional. Display name for the sender above. Falls back to the site name
# ("Kipeo Digital") if unset.
CONTACT_FROM_NAME=
CONTACT_TO_EMAIL=kipeo@harunlucas.com

# Optional. Cloudflare Turnstile bot protection for the contact form.
# Leave both unset to run without Turnstile (the form still has a honeypot,
# rate limiting and server-side validation).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The Kipeo Impact Build application form (/impact-build/apply, posting to
# /api/impact-build) reuses all of the variables above — BREVO_API_KEY,
# CONTACT_FROM_EMAIL, CONTACT_FROM_NAME, CONTACT_TO_EMAIL and the Turnstile
# keys. No separate inbox or key is required. See
# docs/impact-build-operations.md.

# Optional, and only for testing. The Impact Build's real status lives in
# src/content/impact-build.ts (committed as "draft"). Setting this to "open"
# (etc.) here overrides that — set it locally, or on a Vercel Preview
# environment only, to test the live application flow. NEVER set this on the
# Production environment in Vercel.
NEXT_PUBLIC_IMPACT_BUILD_STATUS_OVERRIDE=
